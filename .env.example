# Development/simulation only. Replace every placeholder secret before Compose.
BRASH_TELEOP_CONTROL_TOKEN=replace-with-at-least-16-random-characters
BRASH_TELEOP_EDGE_TOKEN=replace-with-another-at-least-16-random-characters
BRASH_TELEOP_OPERATOR_ID=operator-001
BRASH_TELEOP_ROBOT_ID=b2-unit-001
BRASH_TELEOP_ROBOT_CONTROL_TOKEN=replace-with-a-distinct-robot-control-token
BRASH_TELEOP_MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Immutable observation media simulator. The PWA accepts this loopback origin
# in its optional Media API field. Production live media uses WebRTC instead.
# BRASH_TELEOP_MEDIA_PORT=4312
# BRASH_TELEOP_OPERATOR_ORIGIN=http://127.0.0.1:4310
# Comma-separated exact media/API origins allowed by the operator CSP.
# BRASH_TELEOP_OPERATOR_CONNECT_ORIGINS=http://127.0.0.1:4312

# Optional Ed25519 lease signing. Configure the private key only on control
# plane and the public key only on robot edge; never put key material in env.
# BRASH_TELEOP_LEASE_SIGNING_KEY_ID=control-key-1
# BRASH_TELEOP_LEASE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/teleop-lease-private.pem
# BRASH_TELEOP_LEASE_SIGNING_PUBLIC_KEY_FILE=/run/secrets/teleop-lease-public.pem

# Optional Fleet teleoperation-hold integration. Both values are required
# together. Plain HTTP is accepted only for a loopback development endpoint.
# BRASH_TELEOP_FLEET_URL=http://127.0.0.1:4300/
# BRASH_TELEOP_FLEET_TOKEN=replace-with-a-dedicated-fleet-service-token
# BRASH_TELEOP_FLEET_TIMEOUT_MS=2000
